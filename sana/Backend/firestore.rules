rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /tasks/{id} { allow read, write: if owner(uid); }
      match /courses/{id} { allow read, write: if owner(uid); }
      match /events/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['title', 'course', 'notes', 'start', 'end', 'kind'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 200
          && request.resource.data.course is string && request.resource.data.course.size() <= 200
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 10000
          && request.resource.data.start is timestamp && request.resource.data.end is timestamp
          && request.resource.data.end > request.resource.data.start
          && request.resource.data.kind in ['study', 'exam', 'revision'];
      }
      match /private/{id} { allow read, write: if false; }
    }
  }
}
